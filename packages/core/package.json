{
  "name": "@fairseal/core",
  "version": "1.3.3",
  "description": "Cryptographic primitives, signing, and Merkle trees for FairSeal",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "veo-2.schema.json"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "jest --runInBand",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openrng",
    "veo",
    "verifiable",
    "execution",
    "ai",
    "trust",
    "observability"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ned-del/openrng",
    "directory": "packages/core"
  },
  "homepage": "https://openrng.io",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
