{
  "name": "@fairseal/auto",
  "version": "0.1.2",
  "description": "Auto-instrument AI SDK calls to emit VEO-2 objects. One line, zero code changes.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "jest --runInBand",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@fairseal/core": "^1.3.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "openrng",
    "veo",
    "auto",
    "instrumentation",
    "ai",
    "openai",
    "anthropic",
    "observability"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ned-del/openrng",
    "directory": "packages/auto"
  }
}
