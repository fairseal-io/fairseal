{
  "name": "@fairseal/client",
  "version": "0.1.0",
  "description": "One-line provably fair selection using FairSeal commit/reveal",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "echo 'Run: npx tsx examples/fair-selection-ts/fair-selection.ts'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openrng",
    "provably-fair",
    "randomness",
    "commit-reveal",
    "vdf",
    "verifiable"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ned-del/openrng",
    "directory": "packages/client"
  },
  "homepage": "https://openrng.io",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
